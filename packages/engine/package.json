{
  "name": "@docforge/engine",
  "version": "0.1.0",
  "private": false,
  "description": "The DocForge dialect engine — Markdown plus the DocForge dialect to a themed, paginated document DOM",
  "keywords": [
    "markdown",
    "marked",
    "docforge",
    "dialect",
    "typesetting",
    "document-engine"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rakshit-737/docforge.git",
    "directory": "packages/engine"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./global": "./src/global.ts"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.11",
    "happy-dom": "^20.0.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.18.1",
    "marked": "^18.0.7",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./global": {
        "types": "./dist/global.d.ts",
        "default": "./dist/global.js"
      }
    }
  }
}
